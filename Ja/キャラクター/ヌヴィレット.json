  "passives": [
    {
      "name": "古海継嗣の権威",
      "description": "チームにいるキャラクターが敵に蒸発、凍結、感電、月感電、開花、月開花、水元素拡散、水元素結晶または月結晶反応を起こすと、ヌヴィレットに「遺龍の栄光」効果を付与する。継続時間30秒、最大3層まで重ね掛け可能。層数に応じて、重撃・衡平な裁量は通常の110%/125%/160%分のダメージを与えられるようになる。\n生成された「遺龍の栄光」効果は元素反応ごとにカウントされる。"
    },
    {
      "name": "至高なる審理の紀律",
      "description": "現在HPが上限の30%を超えている場合、超えた分1%につき、ヌヴィレットの水元素ダメージ+0.6%。この効果によってアップできる水元素ダメージは最大30%までとなる。"
    },
    {
      "name": "潮波のように集いて",
      "description": "チーム内の自身のキャラクター全員が水中を素早く泳ぐ時、移動速度+15%。\n同じ効果を持つ固有天賦との重ね掛け不可。"
    }
  ],
  "constellations": [
    {
      "level": 1,
      "name": "1. 尊栄の創定",
      "description": "ヌヴィレット登場時、固有天賦「古海継嗣の権威」による「遺龍の栄光」を1層獲得する。固有天賦「古海継嗣の権威」を解放する必要がある。\nさらに、集力・心証開示と重撃・衡平な裁量を発動時、ヌヴィレットの中断耐性がアップする。"
    },
    {
      "level": 2,
      "name": "2. 律法の懲罰",
      "description": "固有天賦「古海継嗣の権威」は以下のように強化される。「遺龍の栄光」1層につき、重撃・衡平な裁量の会心ダメージ+14%。この方法でアップできる会心ダメージは最大42%まで。\n固有天賦「古海継嗣の権威」を解放する必要がある。"
    },
    {
      "level": 3,
      "name": "3. 旧時の擬制",
      "description": "通常攻撃·清きこと水の如しのスキルLv.+3。\n最大Lv.15まで。"
    },
    {
      "level": 4,
      "name": "4. 憐憫の玉冠",
      "description": "ヌヴィレットがフィールド上にいる、かつ治療効果を受けた時、源水の雫を1個生成する。この効果は4秒毎に最大1回のみ発動可能。"
    },
    {
      "level": 5,
      "name": "5. 公義の裁定",
      "description": "海よ、私は帰ってきたのスキルLv.+3。\n最大Lv.15まで。"
    },
    {
      "level": 6,
      "name": "6. 憤怒の報償",
      "description": "重撃·衡平な裁量を発動時、ヌヴィレットは一定範囲内の源水の雫を吸収できる。源水の雫を1個吸収するごとに、重撃·衡平な裁量の継続時間+1秒。\nさらに、重撃·衡平な裁量が敵に命中すると、2秒毎に追加で洪水を2つ放つ。洪水は1つにつき、ヌヴィレットのHP上限10%分の水元素ダメージを与える。この方法によるダメージは、重撃·衡平な裁量のダメージと見なされる。"
    }
  ],
