  "passives": [
    {
      "name": "突破天赋1",
      "description": "元素战技持续期间，队伍内生成的星辉风旋将转为「流荡风旋」，流荡风旋生成和引爆时会使附近敌人的风元素抗性降低30%，持续6秒。"
    },
    {
      "name": "突破天赋2",
      "description": "进入麦克风召唤状态时，沃雅妮莎获得17层{LINK#N11400001}「独奏」{/LINK}和10层{LINK#N11400002}「协奏」{/LINK}。"
    },
    {
      "name": "固有天赋",
      "description": "在非战斗状态下，元素战技长按可以持续消耗体力使沃雅妮莎在人鱼形态下高速移动，期间可以在水面移动，持续一段时间、体力耗尽或再次施放元素战技可以退出状态。\n另外，沃雅妮莎在游泳状态下也会以更高的体力消耗换来更快的移动速度……"
    },
    {
      "name": "生活天赋",
      "description": "沃雅妮莎在演奏乐器时，不会发出乐器原本的声音，而是转为自己唱歌的阿卡贝拉人声演奏。"
    }
  ],
  "constellations": [
    {
      "level": 1,
      "name": "1. 命座1",
      "description": "沃雅妮莎每次进行治疗时，会使附近队伍中角色的攻击力提升，提升值基于沃雅妮莎生命值上限的0.7%，持续3秒。"
    },
    {
      "level": 2,
      "name": "2. 命座2",
      "description": "每次麦克风攻击时，沃雅妮莎将获得「合奏」效果，使当前场上角色的水元素伤害与冰元素伤害的暴击伤害提升50%，持续5秒；\n若场上存在或最近存在过「流荡风旋」，「合奏」会被异化为「变奏」，使当前场上角色造成的星扩散反应的暴击伤害提升60%，持续5秒。\n此外，元素战技的麦克风召唤持续时间延长9秒。"
    },
    {
      "level": 3,
      "name": "3. 命座3",
      "description": "元素战技{LINK#S11402}元素战技{/LINK} 的技能等级提高3级。\n至多提升至15级。"
    },
    {
      "level": 4,
      "name": "4. 命座4",
      "description": "沃雅妮莎每次进行治疗时，将基于被治疗角色的生命值获得不同效果：\n· 若被治疗角色生命值低于40%，此次治疗量提升50%；\n· 若被治疗角色生命值高于40%，将使沃雅妮莎自身生命值提升20%，持续6秒，至多叠加3层，每层独立计时。"
    },
    {
      "level": 5,
      "name": "5. 命座5",
      "description": "元素爆发{LINK#S11405}元素爆发{/LINK} 的技能等级提高3级。\n至多提升至15级。"
    },
    {
      "level": 6,
      "name": "6. 命座6",
      "description": "命座2里，「合奏」或「变奏」将对附近队伍中角色全体生效\n此外，元素战技的麦克风召唤期间，附近队伍中角色造成的星扩散伤害擢升25%，造成的水元素伤害与冰元素伤害提升50%。"
    }
