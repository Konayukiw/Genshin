  "passives": [
    {
      "name": "获选者的春祭",
      "description": "奥黛塔召唤{LINK#N11500001}独舞倒影{/LINK}时，还会获得4层{LINK#N11500003}华彩{/LINK}。"
    },
    {
      "name": "赤忱者的悲歌",
      "description": "基于奥黛塔攻击力超过1000点的部分，每100点攻击力都将使奥黛塔造成的星烁反应伤害额外造成原本1.5%的伤害，至多通过这种方式额外造成原本30%的伤害。"
    },
    {
      "name": "星耀祝礼·银晓之舞",
      "description": "处于{LINK#N11330003}极星辉域{/LINK}中时/队伍中的角色在附近触发星扩散反应后的8秒内，奥黛塔将分别进入辉映·星超导/辉映·星扩散状态。\n队伍中的角色触发超导/冰元素扩散反应时，将转为触发星超导/星扩散反应，且基于奥黛塔的攻击力，提升队伍中角色造成的上述反应的基础伤害：每100点攻击力都将提升0.7%上述反应的基础伤害，至多通过这种方式提升14%伤害。"
    },
    {
      "name": "回响中的冬梦",
      "description": "在小地图上显示周围的至冬区域特产的位置。\n在闲暇时练习舞蹈，或许还会触发其他的效果…"
    }
  ],
  "constellations": [
    {
      "level": 1,
      "name": "1. 「不曾起舞的清晨，她望向倒影」",
      "description": "施放特殊元素战技{LINK#N11500002}柔板·破晓终奏{/LINK}后，在共舞结束时，奥黛塔将对附近的敌人造成一次额外的冰元素范围伤害，该伤害视为：\n·辉映·星超导或不处于辉映状态：相当于奥黛塔攻击力300%的星超导反应伤害；\n·辉映·星扩散：相当于奥黛塔攻击力450%的星扩散反应伤害。\n\n此外，突破天赋「获选者的春祭」获得强化：召唤{LINK#N11500001}独舞倒影{/LINK}时，奥黛塔将额外获得2层{LINK#N11500003}华彩{/LINK}，且奥黛塔处于队伍后台时，清除华彩的速度提升至每秒2层。"
    },
    {
      "level": 2,
      "name": "2. 「她想，我要见证雪鹄未见之梦」",
      "description": "突破天赋「获选者的春祭」获得强化：每层{LINK#N11500003}华彩{/LINK}还会使角色的攻击力提升7%。\n此外，{LINK#N11500001}独舞倒影{/LINK}在场时，若奥黛塔处于{LINK#N11500004}辉映·星烁{/LINK}状态，独舞倒影附近敌人的对应元素抗性还会降低20%：\n·辉映·星超导：冰元素、雷元素；\n·辉映·星扩散：冰元素、风元素。"
    },
    {
      "level": 3,
      "name": "3. 「我要追逐呼啸的风，向上独行」",
      "description": "元素战技{LINK#S11502}柔板·幻灵夜舞{/LINK}的技能等级提高3级。\n至多提升至15级。"
    },
    {
      "level": 4,
      "name": "4. 「向上，坠往恍惚、燃烧的蓝空」",
      "description": "元素爆发疾板·苍羽一梦获得强化：奥黛塔获得雪鹄之梦时，还会使队伍中附近的其他角色造成的星烁反应伤害提升，提升值相当于雪鹄之梦效果的50%。\n\n此外，队伍中的角色对敌人造成星烁反应伤害时，奥黛塔还会对敌人进行一次协同攻击，造成一次冰元素范围伤害，每3.5秒至多触发一次，该伤害视为：\n·辉映·星超导或不处于辉映状态：相当于奥黛塔攻击力66%的星超导反应伤害；\n·辉映·星扩散：相当于奥黛塔攻击力99%的星扩散反应伤害。"
    },
    {
      "level": 5,
      "name": "5. 「看呀，我已告别尘与土的苦痛」",
      "description": "元素爆发{LINK#S11505}疾板·苍羽一梦{/LINK}的技能等级提高3级。\n至多提升至15级。"
    },
    {
      "level": 6,
      "name": "6. 「伸出手，触及苍穹永恒的面容」",
      "description": "突破天赋「获选者的春祭」获得强化：奥黛塔赋予队伍中附近的所有角色{LINK#N11500003}华彩{/LINK}时，自己的华彩不再会减少。\n此外，处于华彩影响下的角色，对敌人造成的星烁反应伤害{LINK#N11190007}擢升{/LINK}25%，且奥黛塔对敌人造成的星烁反应伤害额外擢升20%。"
    }
