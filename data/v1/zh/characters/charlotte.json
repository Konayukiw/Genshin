  "passives": [
    {
      "name": "冲击力瞬间",
      "description": "带有「聚焦印象」印记的敌人被击败时，取景·冰点构图法的冷却时间减少2秒。每12秒至多通过这种方式减少4次元素战技的冷却时间。"
    },
    {
      "name": "多样性调查",
      "description": "除夏洛蒂自己以外，队伍中每存在1/2/3位枫丹角色，夏洛蒂自己获得5%/10%/15%治疗加成；队伍中每存在1/2/3位非枫丹的角色，都将使夏洛蒂自己获得5%/10%/15%冰元素伤害加成。"
    },
    {
      "name": "第一人称快门",
      "description": "夏洛蒂在启用「特殊分析变焦镜头」后，元素战技「取景·冰点构图法」的长按无法造成原本的效果，转而能以较为特别的方式进行留影…"
    }
  ],
  "constellations": [
    {
      "level": 1,
      "name": "1. 以核实为约束",
      "description": "定格·全方位确证对角色进行治疗后，将为角色施加「核实」印记，每2秒为角色恢复生命值，回复量相当于夏洛蒂攻击力的80%，该效果持续6秒。"
    },
    {
      "level": 2,
      "name": "2. 以求真为职守",
      "description": "施放取景·冰点构图法时，「温亨廷先生」的攻击命中了1/2/3及以上名敌人时，夏洛蒂自身的攻击力提升10%/20%/30%，持续12秒。"
    },
    {
      "level": 3,
      "name": "3. 以独立为先决",
      "description": "定格·全方位确证的技能等级提高3级。\n至多提升至15级。"
    },
    {
      "level": 4,
      "name": "4. 以督促为责任",
      "description": "定格·全方位确证命中附有「瞬时剪影」或「聚焦印象」印记的敌人时，造成的伤害提升10%，并且为夏洛蒂自身恢复2点能量。每20秒，至多通过这种方式恢复5次元素能量。"
    },
    {
      "level": 5,
      "name": "5. 以良知为原则",
      "description": "取景·冰点构图法的技能等级提高3级。\n至多提升至15级。"
    },
    {
      "level": 6,
      "name": "6. 以有趣相关为要义",
      "description": "当前场上角色的普通攻击与重击命中附有取景·冰点构图法的「聚焦印象」的敌人后，「温亨廷先生」将进行协同攻击，造成相当于夏洛蒂攻击力180%的冰元素范围伤害，并为攻击范围内的当前场上角色恢复生命值，回复量相当于夏洛蒂攻击力的42%。该效果每6秒至多触发一次，通过这种方式造成的伤害与治疗效果视为夏洛蒂的元素爆发造成的伤害与治疗效果。"
    }
  ],
