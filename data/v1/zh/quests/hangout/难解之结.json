  "region": null,
  "quests": [
    {
      "title": "神秘前辈…？",
      "dialogue": [
        {
          "section": "提纳里"
        },
        {
          "s": 0,
          "t": "哦，对了，还有一件事。虽然乍一见面，你可能会觉得她难以相处。"
        },
        {
          "s": 0,
          "t": "但只要在称呼她的时候，加上「前辈」这后缀，珐露珊前辈…就会变得好说话许多。"
        }
      ],
      "description": "禅那园中的提纳里，正在等候一位神秘的前辈…"
    },
    {
      "title": "必读经典",
      "dialogue": [
        {
          "section": "法尔罗赫"
        },
        {
          "s": 1,
          "t": "一百年前的流行书…听上去不是能热卖的类型呢。"
        },
        {
          "section": "德拉夫什"
        },
        {
          "s": 2,
          "t": "话说回来，你们有没有看上什么别的东西？只要价钱合适，这本书可以搭赠给你们！"
        }
      ],
      "description": "为了柯莱与全须弥的未来，珐露珊决定开一门识字课…"
    },
    {
      "title": "早教机关",
      "dialogue": [
        {
          "section": "娜德瓦"
        },
        {
          "s": 3,
          "t": "总算能给上头一个交代了，真是多谢你们了。"
        },
        {
          "s": 3,
          "t": "要不然，还真不知道要怎么说动这位老前辈…"
        },
        {
          "section": "阿尼斯"
        },
        {
          "s": 4,
          "t": "珐露珊前辈，居然真的愿意指导我了？真是太荣幸了！"
        },
        {
          "s": 4,
          "t": "啊，不过她肯定会说，「协助绘制不算指导」…你可不要随便跟她说啊。"
        },
        {
          "section": "马姆杜"
        },
        {
          "s": 5,
          "t": "不愧是教令院的老前辈，刚见面的时候，我还在想她看着这么年轻，会不会不太靠谱…"
        },
        {
          "s": 5,
          "t": "啊，这话可不能让她听见，阿尼斯她嘱咐过我的…"
        },
        {
          "section": "鲁希, 卡西特, 阿利娅"
        },
        {
          "s": 6,
          "t": "要等整整两天才能见到新玩具啊…"
        },
        {
          "s": 7,
          "t": "说不定还只是图册呢，想玩到成品，又得等好长一段时间。"
        },
        {
          "s": 8,
          "t": "这段时间里，只能先玩玩《七圣召唤》解闷了吧…"
        },
        {
          "section": "提纳里"
        },
        {
          "s": 0,
          "t": "{NICKNAME}，你已经见过珐露珊前辈了吗？"
        },
        {
          "sit": "是，她还有点事…"
        },
        {
          "sit": "大概还需要两天…"
        },
        {
          "s": 0,
          "t": "没事的，柯莱已经和我说了事情的大致经过。"
        },
        {
          "s": 0,
          "t": "我这边的问题…现在也算是想办法缓解了一些，应该可以等到前辈事了。"
        },
        {
          "s": 0,
          "t": "能麻烦你两天之后，再去看看前辈的情况吗？"
        }
      ],
      "description": "为了孩子们与教令院的未来，珐露珊决定协助阿折罗造像…"
    },
    {
      "title": "孤影徘徊",
      "dialogue": [
        {
          "section": "卡卡塔"
        },
        {
          "s": 9,
          "t": "咕噜…"
        },
        {
          "section": "卡卡塔, 珐露珊"
        },
        {
          "s": 9,
          "t": "咕噜…"
        },
        {
          "s": 10,
          "t": "机械生命…没想到在百年后的须弥，会以这样的方式重新见到。"
        },
        {
          "section": "柯莱"
        },
        {
          "s": 11,
          "t": "没想到，机械生命居然也会生病…一定要好起来呀！"
        },
        {
          "section": "提纳里, 柯莱, 卡卡塔"
        },
        {
          "s": 0,
          "t": "「全自动灌溉机关」…珐露珊前辈，还真是留了个麻烦的课题下来。"
        },
        {
          "s": 11,
          "t": "师父，有什么我能帮上忙的吗？不管是去采购材料，还是准备纸笔…"
        },
        {
          "s": 0,
          "t": "唉…我记得，你今天还有不少功课要做吧？"
        },
        {
          "s": 11,
          "t": "欸？是、是的。"
        },
        {
          "s": 0,
          "t": "尽快把功课做完，早点上床睡觉，不要让珐露珊前辈担心，就是最大的帮助了。"
        },
        {
          "s": 11,
          "t": "呜…好的。"
        },
        {
          "s": 9,
          "t": "咕噜…"
        },
        {
          "section": "疲惫的村民"
        },
        {
          "s": 12,
          "t": "唉…还不能回阿如村吗…"
        },
        {
          "section": "好奇的村民"
        },
        {
          "s": 13,
          "t": "他们这是在挖什么呢…"
        },
        {
          "section": "健谈的村民"
        },
        {
          "s": 14,
          "t": "那台大机械，看着可真威风！"
        },
        {
          "section": "疲惫的村民"
        },
        {
          "s": 12,
          "t": "有关遗迹的事？不清楚，我们也只是受雇来给他们运水运粮的。"
        },
        {
          "s": 12,
          "t": "别说发掘现场了，就连他们住的营地都不让我们靠近呢。"
        },
        {
          "section": "好奇的村民"
        },
        {
          "s": 13,
          "t": "这片区域之前经常有沙尘暴肆虐，最近不知道为什么平息了一些…"
        },
        {
          "s": 13,
          "t": "听说是一位旅行者给解决的？这是人能办到的事儿吗？"
        },
        {
          "section": "健谈的村民"
        },
        {
          "s": 14,
          "t": "那台大机械，看着好威风啊！不会就是传说中的「遗迹徘徊者」吧？"
        },
        {
          "s": 14,
          "t": "地方好像也能对得上…难不成那个传说是真的？"
        },
        {
          "section": "巴克尔"
        },
        {
          "s": 15,
          "t": "站住！没有拉伊德先生的允许，闲杂人等不得靠近！"
        },
        {
          "section": "拉伊德"
        },
        {
          "s": 16,
          "t": "那边刚好有村民偶尔休息用的帐篷，虽然简陋了点，但还请两位不要嫌弃。"
        },
        {
          "section": "拉伊德"
        },
        {
          "s": 16,
          "t": "竟然打扰到前辈休息，真是抱歉。我会叮嘱手下人，手脚都放轻点的。"
        },
        {
          "section": "机械残骸"
        },
        {
          "s": 17,
          "t": "（庞大的机械残骸一动不动…）"
        },
        {
          "section": "纸张泛黄的留信"
        },
        {
          "s": 18,
          "t": "「…塔米米的改造很顺利，现在的它，已经可以通过自我迭代，处理遗迹中的各种险情…真希望你能亲眼看到。」"
        },
        {
          "s": 18,
          "t": "「我在改造它的时候一直在想：如果是你来操刀，能不能做得更好？」"
        },
        {
          "s": 18,
          "t": "「…毕竟你是我见过最出色的学生。」"
        },
        {
          "section": "字迹工整的留信"
        },
        {
          "s": 19,
          "t": "「…珐露珊前辈台鉴。」"
        },
        {
          "s": 19,
          "t": "「塔米米所留笔记手稿等，均已整理誊写完毕，皆署尊名。」"
        },
        {
          "s": 19,
          "t": "「…惟望我等百年之后，后世学生犹记珐露珊前辈之名。」"
        },
        {
          "section": "反复删改的留信"
        },
        {
          "s": 20,
          "t": "「…都叫你不要总是在…你看现在…这么多人…担心…就连…塔米米…」"
        },
        {
          "s": 20,
          "t": "（潦草的字迹被反复地涂写删改，只留下一些模糊的字段…与信纸背面一句一板一眼的留言。）"
        },
        {
          "s": 20,
          "t": "「…快点回家吃饭吧，你妈每次做饭都要多做一碗。」"
        },
        {
          "section": "珐露珊"
        },
        {
          "s": 10,
          "t": "（珐露珊低头不语…沙漠中仿佛只有风扬起尘沙的碎响。）"
        },
        {
          "section": "卡卡塔, 柯莱"
        },
        {
          "s": 9,
          "t": "咕噜！咕噜！"
        },
        {
          "s": 11,
          "t": "看起来状态不错呢，不过就算治好了病，也得注意休养哦。"
        },
        {
          "section": "提纳里"
        },
        {
          "s": 0,
          "t": "前辈修好卡卡塔后就出去了…她好像还有什么事要找你？"
        },
        {
          "s": 0,
          "t": "…嗯，你们之间的事，我就不多过问了。不过，有什么需要帮忙的话，尽管开口。"
        }
      ],
      "description": "成功摆脱教令院的纠缠后，珐露珊决定先前往禅那园…"
    }
