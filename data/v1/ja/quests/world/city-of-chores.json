  "quests": [
    {
      "title": "城内の諸々",
      "dialogue": [
        {
          "section": "望雅"
        },
        {
          "s": 0,
          "t": "はぁ…まだまだ仕事が終わらないわ…"
        },
        {
          "s": 1,
          "t": "どうしたの？"
        },
        {
          "s": 0,
          "t": "大丈夫よ、海灯祭で溜まってた用事を整理してたの。"
        },
        {
          "s": 0,
          "t": "ただ…整理すればするほど…"
        },
        {
          "s": 0,
          "t": "もちろん同僚にも少し分けたんだけど、今年は私の班が霄灯を送ることになったの…だから早く準備しないと…"
        },
        {
          "sit": "霄灯を…？"
        },
        {
          "sit": "たくさんの人に送るの？"
        },
        {
          "s": 0,
          "t": "そう…でも多分あなたが考えている「霄灯を送る」とは違うわ。ただ送るだけじゃないの。"
        },
        {
          "s": 0,
          "t": "一言で言えば…祭りの祝福や雰囲気を届けると言った方がいいのかしら…"
        },
        {
          "s": 0,
          "t": "例えば、海灯祭期間中は、みんな家に帰ってるでしょ。お店もほとんど休みを取ってるし…"
        },
        {
          "s": 0,
          "t": "でも祭りの秩序を守ったり、事務を処理したりするために、千岩軍は海灯祭でも勤務してるの。"
        },
        {
          "s": 0,
          "t": "だから祭り期間中は、総務司がその人たちのためにお土産を届けに行くのよ…"
        },
        {
          "s": 0,
          "t": "私もちょうど、城の護衛をしている千岩軍の人たちに「霄灯を送る」ところだったの。"
        },
        {
          "s": 0,
          "t": "でも…あいにく人手が足りなくてね…まだ届けられていない分もあって…"
        },
        {
          "s": 0,
          "t": "旅人、お土産を届ける手伝いをしてくれるかしら？"
        },
        {
          "s": 1,
          "t": "任せて。"
        },
        {
          "s": 0,
          "t": "本当？ありがとう、じゃあ頼んだわよ。"
        },
        {
          "s": 1,
          "t": "誰に届けるの？"
        },
        {
          "s": 0,
          "t": "確認するね…えっと…まだ届けられていない千岩軍の人は…"
        },
        {
          "s": 0,
          "t": "向明…弘毅…それと蔡楽ね。"
        },
        {
          "s": 0,
          "t": "彼らの位置を記しておくから、頼んだわよ。"
        },
        {
          "s": 1,
          "t": "たくさんの人に送るの？"
        },
        {
          "section": "向明"
        },
        {
          "s": 2,
          "t": "ん？何か用か？今勤務中だ…"
        },
        {
          "s": 1,
          "t": "海灯祭のお土産について。"
        },
        {
          "s": 2,
          "t": "静かに！勤務中なんだぞ。なになに、お土産？"
        },
        {
          "s": 2,
          "t": "総務司から届けてくれたのか？そうか…"
        },
        {
          "s": 2,
          "t": "はぁ、また海灯祭か…今年こそは家に帰りたかったんだがな…"
        },
        {
          "s": 2,
          "t": "しかしこの状況だと、気を緩められそうにない…帰るのは何日か先か…"
        },
        {
          "s": 2,
          "t": "届けてくれてありがとう。これはもらっておくよ。ご苦労様。"
        },
        {
          "s": 2,
          "t": "はぁ、あの人いつになったら離れるんだ…"
        },
        {
          "section": "望雅"
        },
        {
          "s": 0,
          "t": "おかしいわね…蔡尋のは届けたのに、蔡楽のはまだ…"
        },
        {
          "s": 0,
          "t": "はぁ、お土産を届けた人が間違えたのね…"
        },
        {
          "section": "弘毅"
        },
        {
          "s": 3,
          "t": "この井戸水はどうなってるんだ…"
        },
        {
          "s": 1,
          "t": "海灯祭のお土産について。"
        },
        {
          "s": 3,
          "t": "おっ、総務司からのお土産か。受け取るよ、ありがとう。"
        },
        {
          "s": 3,
          "t": "でも、俺はまだここで勤務する必要がある。市民がここに水を汲みに来るかもしれないからね。"
        },
        {
          "s": 3,
          "t": "はぁ、この井戸水、どうなってるんだ…飲めないってことだけは確かだが…"
        },
        {
          "section": "一弦"
        },
        {
          "s": 4,
          "t": "うぅ…まだ、願い事が書き終わってないよ…"
        },
        {
          "s": 5,
          "t": "…泣くな。千岩軍のおじさんが取ってきてくれるから…"
        },
        {
          "s": 1,
          "t": "蔡楽について…"
        },
        {
          "s": 5,
          "t": "あの千岩軍のおじさんを探してるの？"
        },
        {
          "s": 5,
          "t": "さっき一弦が霄灯に願い事を書いてた時、うっかり空に飛ばしちゃって…"
        },
        {
          "s": 5,
          "t": "あの千岩軍のおじさんが、霄灯が木に引っかかってたのを見たらしくて…それで、僕たちのために取ってきてくれるって…"
        },
        {
          "sit": "あの霄灯は特別なの？"
        },
        {
          "sit": "もう一つ新しいの作らないの？"
        },
        {
          "s": 5,
          "t": "僕も一弦にそう言ったんだけど…でも…"
        },
        {
          "s": 4,
          "t": "うぅ…いやだよ…あれは兄さんがやっとのことで作ったやつだから…"
        },
        {
          "s": 5,
          "t": "一弦泣くな、千岩軍のおじさんはもうすぐ戻ってくるよ…"
        },
        {
          "s": 5,
          "t": "だからごめんね。もしあの千岩軍のおじさんを探してるのなら、あっちの方を見てきて。"
        },
        {
          "s": 1,
          "t": "もう一つ新しいの作らないの？"
        },
        {
          "section": "蔡楽"
        },
        {
          "s": 6,
          "t": "うーん…どうやって上に登れば…いや、やはり別の方法を…"
        },
        {
          "s": 1,
          "t": "なにしてるの？"
        },
        {
          "s": 6,
          "t": "旅人ですか？あはは、何でもありません。ただ、あの霄灯を取るために上に登る方法を考えていたんです。"
        },
        {
          "s": 6,
          "t": "この木は登るのが難しくて、鎧を着ている私では、途中で滑り落ちてしまうんです…"
        },
        {
          "s": 6,
          "t": "えっと…その、もしよろしければ、上に登って霄灯を取ってきてくれませんか？"
        },
        {
          "s": 1,
          "t": "任せて。"
        },
        {
          "s": 6,
          "t": "ありがとうございます。あの子供がずっと泣き止まなくて、早く霄灯を持って戻らないと…"
        },
        {
          "section": "一弦"
        },
        {
          "s": 4,
          "t": "うぅ…願い事が書き終わらなかったら…叶わないのかな…"
        },
        {
          "s": 5,
          "t": "そんなことないよ、元気出して…"
        },
        {
          "section": "蔡楽"
        },
        {
          "s": 6,
          "t": "あの霄灯が木に引っかかってくれてよかったです。もし高いところへ飛んでいたら、取れませんから…"
        },
        {
          "section": "蔡楽"
        },
        {
          "s": 6,
          "t": "どうですか、霄灯は取れましたか？"
        },
        {
          "s": 1,
          "t": "手に入れた。"
        },
        {
          "s": 6,
          "t": "どれどれ…はい、これです！本当にありがとうございました。今すぐあの子たちに届けてきます。"
        },
        {
          "s": 6,
          "t": "もう随分時間が経ってしまいました。まだあの場所にいるといいのですが…"
        },
        {
          "s": 1,
          "t": "お土産について…"
        },
        {
          "s": 6,
          "t": "総務司からですか、受け取っておきます。届けてくれてありがとうございました。"
        },
        {
          "s": 1,
          "t": "これも千岩軍の職務なの？"
        },
        {
          "s": 6,
          "t": "霄灯のことですか？あはは、もちろんです。"
        },
        {
          "s": 6,
          "t": "霄灯を取ったり、不審者を追っ払ったり、魔物を退治したり…"
        },
        {
          "s": 6,
          "t": "助けが必要な人を助ける、それが千岩軍の職務です。"
        },
        {
          "s": 6,
          "t": "では、あらためて感謝を。私は今すぐ霄灯をあの子たちに届けてきます。"
        },
        {
          "s": 6,
          "t": "それから他の用事を済ませなければ…"
        },
        {
          "section": "望雅"
        },
        {
          "s": 0,
          "t": "おかえりなさい、お土産は届けてくれた？"
        },
        {
          "s": 1,
          "t": "全員に届けた。"
        },
        {
          "s": 0,
          "t": "ありがとう…あなたがいてくれて、本当に助かったわ。"
        },
        {
          "s": 1,
          "t": "千岩軍は祭りの時も休みがないの？"
        },
        {
          "s": 0,
          "t": "それは…はぁ、総務司もできるだけ交代制で勤務を手配してるけど…"
        },
        {
          "s": 0,
          "t": "璃月は大きいから、警備や見回りをする場所が多すぎるのよ。"
        },
        {
          "s": 0,
          "t": "交代制を行っても、人手不足が解消しないの。だからいつも誰かが残業することになるわけ。"
        },
        {
          "s": 0,
          "t": "それに今年の海灯祭は往年より盛大でしょ、警備や見回りの圧力が高くて…どんなに人手を調整しても足りないの…"
        },
        {
          "sit": "それは大変だったね…"
        },
        {
          "sit": "お疲れ様。"
        },
        {
          "s": 0,
          "t": "ありがとう、でも大丈夫。これも私たちがやるべきことだから…それに海灯祭が上手くいってくれれば、私たちも頑張った甲斐があるというものよ。"
        },
        {
          "s": 0,
          "t": "そうだ、海灯祭期間は他にも助けが必要な人が大勢いると思うから、もしよかったら色々協力してくれると助かるわ。"
        },
        {
          "s": 0,
          "t": "もっとたくさんの人に「海灯祭」に来てもらえたら、祭りもより賑やかになるかもね。"
        },
        {
          "s": 0,
          "t": "私たちが「霄灯を送る」理由はね、誰もが霄灯を飛ばせて、願い事ができるようにするためなの。"
        },
        {
          "s": 0,
          "t": "もっと広く言えば…「海灯祭」を一人一人に届けて、祭りの雰囲気を楽しんでもらうためよ。"
        },
        {
          "s": 0,
          "t": "だって、海灯祭はみんなの祭りなんだから。"
        },
        {
          "s": 0,
          "t": "さて、私はまだ用事があるからもう行くわね。あなたが海灯祭を楽しんでくれることを祈ってるわ。"
        },
        {
          "s": 1,
          "t": "お疲れ様。"
        }
