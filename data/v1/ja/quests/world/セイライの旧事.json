  "quests": [
    {
      "title": "セイライの旧事",
      "dialogue": [
        {
          "section": "古谷昇"
        },
        {
          "s": 0,
          "t": "困ったなぁ…"
        },
        {
          "s": 1,
          "t": "この図について…"
        },
        {
          "s": 0,
          "t": "この図にある地形から察するに、セイライ島にある場所みたいだ…"
        },
        {
          "s": 1,
          "t": "どうやって分かったの？"
        },
        {
          "s": 0,
          "t": "協会も過去に何度か、セイライ島に関する探索依頼を出したことがあるからね。"
        },
        {
          "s": 0,
          "t": "依頼を受けた冒険者たちが協会へ報告に戻る時、セイライ島に関する情報も一緒に持ってくるんだ。"
        },
        {
          "s": 0,
          "t": "でも人手が足りないから、組織的で大規模な調査はまだ行えてない。時々数名の冒険者を調査に送っているだけだ。"
        },
        {
          "s": 0,
          "t": "だから、僕が持っているセイライ島の情報にも限りがある。君たちのためにこれを解読するのは難しいだろう。"
        },
        {
          "s": 0,
          "t": "ただ、城内に一人だけセイライ島に関わる人がいるのを知ってる。"
        },
        {
          "s": 0,
          "t": "名は太田太郎、彼によると…彼の先祖はかつてセイライ島で暮らしていたんだけど、様々な原因からここに移住してきたらしい。"
        },
        {
          "s": 0,
          "t": "そういえばこの前、セイライ島の視察に同行してくれる冒険者を雇うために、協会に来たことがあった…"
        },
        {
          "s": 0,
          "t": "これを彼のもとに持っていって聞いてみるといい。何か分かるかもしれない。"
        },
        {
          "section": "太田太郎"
        },
        {
          "s": 2,
          "t": "はぁ、いつになったら一緒に行ってくれる人が見つかるんだ…"
        },
        {
          "s": 1,
          "t": "この図について…"
        },
        {
          "s": 2,
          "t": "君は…冒険者協会から来た冒険者か？やっと協会から人手が！？"
        },
        {
          "s": 1,
          "t": "ただの通りすがりの旅人。"
        },
        {
          "s": 2,
          "t": "そっか…ん？何か見せたいものがあるって？"
        },
        {
          "s": 2,
          "t": "どれどれ…"
        },
        {
          "s": 2,
          "t": "こ、これは！まさか…"
        },
        {
          "sit": "何か分かったの？"
        },
        {
          "sit": "これは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の家？"
        },
        {
          "s": 2,
          "t": "これはセイライ島じゃないか！"
        },
        {
          "sit": "うん。"
        },
        {
          "sit": "そうだけど…"
        },
        {
          "s": 2,
          "t": "あははっ、本当にセイライ島だったのか？実は僕も当てずっぽうだったんだ。"
        },
        {
          "s": 2,
          "t": "確かに僕の先祖はセイライ島で暮らしてたけど、それはもうずっと昔のことだ。"
        },
        {
          "s": 2,
          "t": "僕の代じゃ、もうセイライ島に対する印象はほとんどなくなってる。"
        },
        {
          "s": 2,
          "t": "家に残ってるセイライ島に関するものも…3枚の風景画しかない…"
        },
        {
          "s": 1,
          "t": "じゃあなんで帰りたいの？"
        },
        {
          "s": 2,
          "t": "それは…なんて言うか、やっぱり僕の「故郷」だから。"
        },
        {
          "s": 2,
          "t": "なんか…絶対に見に行ってみなきゃっていう気持ちがあるのさ。"
        },
        {
          "s": 2,
          "t": "でも僕はいま商売で忙しくて、ここを離れられない。"
        },
        {
          "s": 2,
          "t": "それに…僕をセイライ島まで護送してくれる冒険者の人も見つからない…"
        },
        {
          "s": 2,
          "t": "だから、考えを変えて冒険者協会で依頼を出したんだ。"
        },
        {
          "s": 2,
          "t": "僕の代わりにセイライ島まで行き、「写真機」を使ってあの3枚の風景画の場所を記録してきてほしい。"
        },
        {
          "s": 2,
          "t": "でもまだ引き受けてくれる冒険者が見つかってない…はぁ…"
        },
        {
          "sit": "任せて。"
        },
        {
          "sit": "手伝ってあげる。"
        },
        {
          "s": 2,
          "t": "ほ、ホント！？手伝ってくれるなんて本当にありがとう！"
        },
        {
          "s": 2,
          "t": "報酬のことは安心して、きちんと準備するから！"
        },
        {
          "s": 2,
          "t": "それじゃ頼んだよ。君が持ってきたのと合わせれば、全部で4枚ある…"
        },
        {
          "s": 2,
          "t": "セイライ島に行って、この4つの場所でそれぞれ写真を撮ってきてくれないか。"
        },
        {
          "s": 1,
          "t": "手伝ってあげる。"
        },
        {
          "s": 1,
          "t": "そうだけど…"
        },
        {
          "s": 1,
          "t": "これは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の家？"
        },
        {
          "section": "太田太郎"
        },
        {
          "s": 2,
          "t": "セイライ島…はぁ、自分の目で見てみたいな。"
        },
        {
          "s": 2,
          "t": "でも、どうやって時間を空けるか…"
        },
        {
          "section": "太田太郎"
        },
        {
          "s": 2,
          "t": "おかえり、どうだった？写真は撮れたのかい？"
        },
        {
          "s": 1,
          "t": "全部撮った。"
        },
        {
          "s": 2,
          "t": "よかった、どれどれ…"
        },
        {
          "s": 2,
          "t": "えっと…"
        },
        {
          "s": 2,
          "t": "あははっ、どこなのかまったく分からないや…"
        },
        {
          "s": 2,
          "t": "でも、あの3枚の風景は、もうだいぶ変わってるようだね。"
        },
        {
          "s": 2,
          "t": "あの藤原俊子さんは…これらの場所を知っているのだろうか。"
        },
        {
          "s": 2,
          "t": "でも…ははっ、彼女も知らないと思うけど…"
        },
        {
          "s": 1,
          "t": "彼女もセイライ島から来たの？"
        },
        {
          "s": 2,
          "t": "正確に言うと、僕と同じく、先祖がセイライ島で暮らしてたんだ。"
        },
        {
          "s": 2,
          "t": "まあ実は、先祖がセイライ島で暮らしてた人は稲妻城にも結構いるんだけどね。"
        },
        {
          "s": 1,
          "t": "どうしてセイライ島から離れたの？"
        },
        {
          "s": 2,
          "t": "それは僕も分からない…もう凄く昔のことだから。"
        },
        {
          "s": 2,
          "t": "雷が激しいからだとか、密輸や密入国を防ぐためだとか、そういう理由じゃないかな…"
        },
        {
          "s": 2,
          "t": "とにかく、幕府の手配で、セイライ島にいたほとんどの人は鳴神島に移住した。"
        },
        {
          "s": 2,
          "t": "そろそろ話を終わりにしよう。これを受け取ってくれ、手伝ってくれてありがとう。"
        },
        {
          "s": 2,
          "t": "はぁ、いつになったらセイライ島に行けるんだ…"
        },
        {
          "s": 2,
          "t": "まずは手元にある仕事を終わらせよう…"
        }
      ],
      "description": "セイライ島でおかしな図を掘り出した…"
    }
  ],
