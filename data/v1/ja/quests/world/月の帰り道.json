  "act_title": "月の帰り道",
  "region": null,
  "quests": [
    {
      "title": "月の帰り道",
      "dialogue": [
        {
          "section": "「少女」"
        },
        {
          "s": 0,
          "t": "……"
        },
        {
          "s": 1,
          "t": "いい匂いがするぞ…"
        },
        {
          "s": 0,
          "t": "……"
        },
        {
          "s": 1,
          "t": "コロンビーナが無我夢中でなにか食べてるぞ！"
        },
        {
          "s": 0,
          "t": "旅人、パイモン…"
        },
        {
          "s": 1,
          "t": "美味しそうに食べてるな…"
        },
        {
          "s": 0,
          "t": "食べる？"
        },
        {
          "s": 2,
          "t": "ううん、ありがとう。"
        },
        {
          "s": 1,
          "t": "ここで食事するところなんか見たことなかったけど…買ってきたのか？"
        },
        {
          "s": 0,
          "t": "ううん、ラウマから。"
        },
        {
          "s": 1,
          "t": "ラウマっていつもおまえのこと気にかけてるよな！"
        },
        {
          "s": 0,
          "t": "でも条件付き——ここを離れるなって。"
        },
        {
          "s": 1,
          "t": "軟禁じゃんか！で、あっさり買収されたのかよ？"
        },
        {
          "s": 0,
          "t": "面白そうな本とかおもちゃも貰った…"
        },
        {
          "s": 1,
          "t": "子供に留守番させようとするお母さんみたいだな…"
        },
        {
          "s": 2,
          "t": "理由は言ってなかったの？"
        },
        {
          "s": 0,
          "t": "ううん、しばらく外に出ないようにってだけ。特に霜月の子には絶対に近づくなって。"
        },
        {
          "s": 0,
          "t": "食べ物を届けてくれた動物たちも、ラウマの指示なのか一切口を割らなかったよ。"
        },
        {
          "s": 1,
          "t": "えっ…"
        },
        {
          "s": 0,
          "t": "あくまで推測だけど…私に関係する何かを準備してるのかも。"
        },
        {
          "s": 0,
          "t": "大丈夫だよ。ここにいるのは嫌じゃないし、美味しいものもたくさん食べられる。外に出られないのは全然苦じゃないよ。"
        },
        {
          "s": 0,
          "t": "それに、もし霜月の子で本当に何か準備してるなら、好奇心を満たすためだけに邪魔するわけにもいかないでしょ？"
        },
        {
          "s": 2,
          "t": "ちょっと聞いてこようか？"
        },
        {
          "s": 1,
          "t": "オイラもすごく気になってきたぞ。"
        },
        {
          "s": 0,
          "t": "いいけど、覚悟はしておいてね。"
        },
        {
          "s": 0,
          "t": "キミたちがここに来ることは、ラウマも予想してたはず…そう簡単にはいかないかも。"
        },
        {
          "section": "ラウマ"
        },
        {
          "s": 1,
          "t": "クータルの像の修復！？"
        },
        {
          "s": 3,
          "t": "うむ。"
        },
        {
          "s": 3,
          "t": "翼を失ったまま、天外の月を眺めていた頃の孤独の「クー{RUBY#[D]月の少女}タル」はもういない。"
        },
        {
          "s": 3,
          "t": "翼を広げ、再び自由を取り戻す姿を我々はこの目で見届けた。"
        },
        {
          "s": 3,
          "t": "ゆえに、神像も修復されるべきだ。"
        },
        {
          "s": 1,
          "t": "いいアイデアだな！"
        },
        {
          "s": 2,
          "t": "霜月の子のみんなにはもう話したの？"
        },
        {
          "s": 3,
          "t": "ああ、クータルの犠牲と再臨、そして…"
        },
        {
          "s": 3,
          "t": "その優しき光に導かれて、皆は世界を汚染する力に抗ったのだと伝えたら…"
        },
        {
          "s": 3,
          "t": "誰もがクータルの帰還を心から喜んでおった。その流れで、コロンビーナさんの考えも伝えたのだ——"
        },
        {
          "s": 3,
          "t": "霜月の子の皆と、家族のように過ごしたいということをな。"
        },
        {
          "s": 2,
          "t": "みんなの反応は？"
        },
        {
          "s": 3,
          "t": "……"
        },
        {
          "s": 4,
          "t": "月神様が…？"
        },
        {
          "s": 5,
          "t": "月神様と家族だなんて…ご無礼なのでは…？"
        },
        {
          "s": 3,
          "t": "しかし、それがコロンビーナさんの心からの願いなのだ。"
        },
        {
          "s": 6,
          "t": "（詠月使様が月神様のことを「コロンビーナさん」と…！）"
        },
        {
          "s": 3,
          "t": "先日話したことを覚えているだろうか——"
        },
        {
          "s": 3,
          "t": "「…道は、真実によって、我々自身の手によって開かれるもの。」"
        },
        {
          "s": 3,
          "t": "私と同じ選択を強要するつもりは毛頭ない。だが、一つだけ助言をさせてくれ——"
        },
        {
          "s": 3,
          "t": "「月明かりを招きたくば、まずは扉を開かねばならぬ。」"
        },
        {
          "s": 3,
          "t": "…というわけで、ここ数日の様子を見る限り、予想よりも事が順調に運んでおる。"
        },
        {
          "s": 7,
          "t": "ラウマ様、新たに届いた石材は倉庫に入れました。"
        },
        {
          "s": 3,
          "t": "ああ、ご苦労さま。"
        },
        {
          "s": 3,
          "t": "今の話とここで見た光景については、コロンビーナさんには内緒にしてくれぬか？「サプライズ」なのでな。"
        },
        {
          "s": 1,
          "t": "月神も信者も、とにかくサプライズが好きみたいだな…"
        },
        {
          "s": 2,
          "t": "うん、分かった。"
        },
        {
          "s": 1,
          "t": "あのさ、ラウマ、口止め料…じゃなくて、今日の饗月の膳ってまだあるか？"
        },
        {
          "s": 3,
          "t": "ふふ、すぐ用意しよう。あ、それともう一つ…"
        },
        {
          "section": "「少女」"
        },
        {
          "s": 0,
          "t": "おかえり。"
        },
        {
          "s": 1,
          "t": "コロンビーナの言った通り、な～んにも教えてもらえなかったぞ！"
        },
        {
          "s": 2,
          "t": "なんだか忙しそうだった。"
        },
        {
          "s": 1,
          "t": "しばらくオイラたちが一緒にいてやるから、楽しみにしててくれ！"
        },
        {
          "s": 0,
          "t": "楽しみって？"
        },
        {
          "s": 1,
          "t": "あっ…！い、いや、オイラ、なにも知らないぞ！"
        },
        {
          "s": 0,
          "t": "ふふ…そう？キミたちと一緒に過ごせるの、楽しみにしてるね。"
        },
        {
          "s": 8,
          "t": "！！"
        },
        {
          "s": 1,
          "t": "おっ！ご飯タイムだな！あれ、食べ物は？"
        },
        {
          "s": 8,
          "t": "！！"
        },
        {
          "s": 0,
          "t": "時間だよ、って言われたけど…何のことだか分かる？"
        },
        {
          "s": 1,
          "t": "ん？おお、わかったぞ。"
        },
        {
          "s": 2,
          "t": "コロンビーナ。"
        },
        {
          "s": 0,
          "t": "ん？"
        },
        {
          "s": 2,
          "t": "君(あなた)は目を閉じてるけど…"
        },
        {
          "s": 0,
          "t": "それがどうかした？"
        },
        {
          "s": 1,
          "t": "目を閉じてても、クーヴァキを使って物事を感知できるんだろ？"
        },
        {
          "s": 0,
          "t": "うん、むしろそのほうがはっきり分かる。"
        },
        {
          "s": 1,
          "t": "えっと…しばらくの間、感知しないようにできないか？"
        },
        {
          "s": 0,
          "t": "サプライズでもあるの？"
        },
        {
          "s": 1,
          "t": "う、バレちゃったか…"
        },
        {
          "s": 0,
          "t": "分かった。じゃあ、手をつないで。"
        },
        {
          "section": "ラウマ"
        },
        {
          "s": 1,
          "t": "着いたぞ。"
        },
        {
          "s": 2,
          "t": "目を開けていいよ。"
        },
        {
          "s": 0,
          "t": "……"
        },
        {
          "s": 1,
          "t": "（本当に目を開けたぞ！）"
        },
        {
          "s": 2,
          "t": "（いつもの癖でつい…）"
        },
        {
          "s": 0,
          "t": "きれい。"
        },
        {
          "s": 0,
          "t": "翼がある…これで完全になったね。"
        },
        {
          "s": 3,
          "t": "「霜月の子」からコロンビーナさんへのプレゼントだ。"
        },
        {
          "s": 3,
          "t": "我々の神がついに自由に飛べるようになったこと…そして、その指先が「家」に触れられたことを祝って、皆で完成させた。"
        },
        {
          "s": 0,
          "t": "…以前はこの神像を見るたび、生まれたときの困惑しか浮かばなかったけど…"
        },
        {
          "s": 0,
          "t": "今は「家」にいるんだって…心があったかくなる。"
        },
        {
          "s": 0,
          "t": "私はこの像と同じように…翼があってもここに留まるって決めたんだね。"
        },
        {
          "s": 0,
          "t": "…みんな、ありがとう。"
        },
        {
          "s": 3,
          "t": "もう一つプレゼントがあるのだが、少し離れたところにあるゆえ…ともに歩かぬか？"
        },
        {
          "s": 1,
          "t": "えっ？まだあるのか？"
        },
        {
          "s": 3,
          "t": "うむ——仲間たちが森の中に簡素な宴を用意してくれた。"
        },
        {
          "s": 3,
          "t": "コロンビーナさん、これからは、霜月の子もあなたの家だ。"
        },
        {
          "s": 3,
          "t": "家が恋しくなったら、いつでも帰ってきてくれ。ともにお茶でもしよう。"
        },
        {
          "s": 0,
          "t": "うん、必ずそうする。"
        },
        {
          "s": 2,
          "t": "月が昇ったよ。"
        },
        {
          "s": 3,
          "t": "さあ、行こう。"
        },
        {
          "s": 3,
          "t": "これからの夜がいつも、あの祈月の夜のように美しくあらんことを。"
        },
        {
          "s": 3,
          "t": "おかえり、コロンビーナさん。"
        }
      ],
      "description": "「銀月の庭」を訪れたが、コロンビーナは何やら困っているようだ…"
    }
  ],
